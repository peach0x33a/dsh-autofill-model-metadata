{
  "name": "dsh-autofill-model-metadata",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "description": "DSH plugin: fill custom-provider model metadata from models.dev through an explicit, pre-declared mapping - no guessing, fail-closed.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "models-dev",
    "model-metadata",
    "context-window",
    "reasoning-effort",
    "explicit-mapping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peach0x33a/dsh-autofill-model-metadata.git"
  },
  "type": "module",
  "main": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "import": "./lib/index.mjs"
    },
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.zh.md",
    "CONFIGURATION.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsdown -c tsdown.config.ts",
    "verify": "tsc --noEmit && tsdown -c tsdown.config.ts && vitest run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cordis": "^4.0.0-rc.8",
    "happy-dom": "^21.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "homepage": "https://github.com/peach0x33a/dsh-autofill-model-metadata#readme",
  "bugs": {
    "url": "https://github.com/peach0x33a/dsh-autofill-model-metadata/issues"
  }
}
